# Copia esto como .env (no se sube al repo)

# IP con la que los clientes externos (los microservicios, ms-kafka-admin, tu PC) alcanzan los brokers.
#  - En AWS: la IP PRIVADA de la EC2 de Kafka (los microservicios estan en la misma VPC y no cambia al reiniciar)
#  - En local: localhost
KAFKA_ADVERTISED_HOST=localhost

# Kafka UI (panel web). Sin esto cualquiera con acceso al puerto podria borrar topicos.
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=cambia-esta-clave
