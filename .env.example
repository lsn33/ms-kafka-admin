# Copia esto como .env (no se sube al repo) o define las variables en tu IDE / systemd
SERVER_PORT=8091
# En la EC2 de Kafka: IP privada de esa misma EC2 (los brokers anuncian esa IP). En local: localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_ADMIN_TIMEOUT_MS=15000
KAFKA_CREAR_TOPICOS_AL_INICIAR=false
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_GSwV2b9S1
